rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to business collections for the Fake application
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /purchase_invoices/{invoiceId} {
      allow read, write: if true;
    }
    match /supplier_payments/{paymentId} {
      allow read, write: if true;
    }
    match /supplier_statements/{statementId} {
      allow read, write: if true;
    }
    match /treasury_transactions/{transactionId} {
      allow read, write: if true;
    }
    match /external_recipients/{recipientId} {
      allow read, write: if true;
    }
    match /app_metadata/{metaId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
